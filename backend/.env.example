# Copy this file to .env and fill in real values. Never commit the real .env.

# Used to sign JWTs. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Google Gemini API key, used by services/gemini_service.py
GEMINI_API_KEY=

# Defaults to a local sqlite file if unset.
DATABASE_URL=sqlite:///site.db

# Comma-separated list of allowed frontend origins, e.g.
# https://ai-hms.example.com,https://staging.ai-hms.example.com
# Defaults to "*" (any origin) if unset - fine for local dev only. Set this
# explicitly before deploying anywhere reachable from the public internet.
CORS_ORIGINS=*

# Set to "true" to enable Flask's debug mode (auto-reload + interactive
# debugger). Never enable this in a deployed/production environment - the
# interactive debugger allows arbitrary code execution.
FLASK_DEBUG=false
